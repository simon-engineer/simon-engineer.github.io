---
import Layout from '../layouts/Layout.astro';
import { publications, patents, programs } from '../data/research';
---

<Layout
  title="Research"
  description="Publications, patents, and DOE-funded research programs."
>
  <h1>Research</h1>
  <p class="muted intro">
    Peer-reviewed publications, patented technologies, and U.S. Department of
    Energy–funded programs in clean combustion and alternative fuels.
  </p>

  <section>
    <h2>Publications</h2>
    <ol class="pub-list">
      {
        publications.map((pub) => (
          <li>
            {pub.url ? (
              <a class="pub-title pub-link" href={pub.url} target="_blank" rel="noopener">
                {pub.title}
              </a>
            ) : (
              <span class="pub-title">{pub.title}</span>
            )}
            <span class="muted pub-meta">
              {pub.authors && <>{pub.authors} · </>}
              {pub.venue}, {pub.year}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>Patents</h2>
    <ul class="plain">
      {
        patents.map((p) => (
          <li>
            {p.url ? (
              <a class="pub-title pub-link" href={p.url} target="_blank" rel="noopener">
                {p.title}
              </a>
            ) : (
              <span class="pub-title">{p.title}</span>
            )}
            <span class="muted pub-meta">
              {p.number} · {p.date}
            </span>
            {p.image && (
              <a class="patent-snapshot" href={p.image} target="_blank" rel="noopener">
                <img
                  src={p.image}
                  alt={`Snapshot of patent ${p.number}: ${p.title}`}
                  loading="lazy"
                  width="1275"
                  height="1650"
                />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>DOE-Funded Programs</h2>
    <p class="muted">Contributing member.</p>
    <ul class="plain">
      {
        programs.map((prog) => (
          <li>
            <span class="pub-title">{prog.title}</span>
            <span class="muted pub-meta">{prog.award}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .intro {
      margin-bottom: 1.5rem;
    }
    .pub-list,
    .plain {
      padding-left: 0;
      list-style-position: outside;
    }
    .pub-list {
      padding-left: 1.3rem;
    }
    .plain {
      list-style: none;
    }
    .pub-list li,
    .plain li {
      margin-bottom: 1rem;
      line-height: 1.45;
    }
    .pub-title {
      display: block;
      font-weight: 500;
    }
    .pub-link {
      color: var(--fg);
      text-decoration: none;
    }
    .pub-link:hover {
      color: var(--accent);
      text-decoration: underline;
    }
    .pub-meta {
      display: block;
      font-size: 0.88rem;
      margin-top: 0.15rem;
    }
    .patent-snapshot {
      display: inline-block;
      margin-top: 0.75rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      line-height: 0;
      transition: border-color 0.15s ease;
    }
    .patent-snapshot:hover {
      border-color: var(--accent);
    }
    .patent-snapshot img {
      display: block;
      width: 240px;
      height: auto;
      background: #fff;
    }
  </style>
</Layout>

---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <div class="card-head">
    <h3>{project.title}</h3>
    {project.year && <span class="year muted">{project.year}</span>}
  </div>
  <p>{project.description}</p>
  {
    project.tags.length > 0 && (
      <ul class="tags">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  {
    project.links && project.links.length > 0 && (
      <div class="links">
        {project.links.map((link) => (
          <a href={link.href}>{link.label} →</a>
        ))}
      </div>
    )
  }
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--bg-subtle);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }
  .year {
    font-size: 0.85rem;
    white-space: nowrap;
  }
  p {
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1rem;
  }
  .tags li {
    font-size: 0.78rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--fg-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
</style>
